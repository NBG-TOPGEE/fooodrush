# Copy to a .env (or export) before running. Never commit real secrets.

# Database
DB_URL=jdbc:postgresql://localhost:5432/foodrush
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (must be at least 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars

# Paystack (leave empty to run in simulation mode — no external calls)
PAYSTACK_SECRET_KEY=

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: load demo data on startup
SEED_DATA=false
